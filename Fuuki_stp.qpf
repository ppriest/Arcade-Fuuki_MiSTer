QUARTUS_VERSION = "17.0"

# The instrumented project on its own: opening this in the Quartus IDE gives
# the Fuuki_stp revision (JTAG probe, Debug OSD page, sound mute switches)
# without the release revision beside it. Fuuki.qpf lists both. The revision
