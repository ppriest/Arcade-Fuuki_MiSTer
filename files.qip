# Source list for the Fuuki core. Sourced by Fuuki.qsf; do NOT add files
# through the Quartus IDE, which rewrites the .qsf instead.

# PLL: 85.909091 MHz (14.318181 x 6) plus the 180-degree phase-shifted
# companion that drives SDRAM_CLK. Taken unchanged from the Psikyo core,
# where this exact phase is proven on hardware -- see Fuuki.sv's CLOCKS note.
set_global_assignment -name QIP_FILE rtl/pll.qip

# TG68K.C -- 68000 (FG-2) and 68EC020 (FG-3). Vendored UNTOUCHED; see
# rtl/cpu/tg68k/PROVENANCE.md. TG68K.vhd is deliberately NOT compiled: the
# kernel is instantiated directly, and that wrapper's falling-edge bus
# emulator is what makes a clock-enabled 68k dangerous to constrain.
set_global_assignment -name VHDL_FILE rtl/cpu/tg68k/TG68K_Pack.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/tg68k/TG68K_ALU.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/tg68k/TG68KdotC_Kernel.vhd

# Main CPU bus wrapper: address decode, bus sequencing, the three IRQs.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/maincpu.sv

# Memory: one SDRAM chip serving every ROM the core reads at runtime.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/sdram/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/sdram_phy.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/sdram_arbiter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/sdram_download.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/sdram_narrow_bridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/fuuki_sdram_top.sv

# Video: timing, registers, three tilemap layers, the sprite path, compositor.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/video_timing.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/vregs.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/line_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/tilemap_line_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/spriteram_dbuf.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/sprite_line_list.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/sprite_zoom_lut.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/sprite_line_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/compositor.sv

# Video helpers vendored from MiSTer-devel. Not instantiated yet: Fuuki is
# ROT0, so rotation is a convenience rather than correctness, and wiring it
# means taking ownership of DDR3.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/screen_rotate_two.sv

# CPU pause, as a joystick button (bit 10 -- see Fuuki.sv's J1 list).
set_global_assignment -name SYSTEMVERILOG_FILE rtl/pause_control.sv

# JTAG in-circuit probe. Counters rather than a waveform, because SignalTap
# acquisition is GUI-only in Quartus Prime Lite 17.0.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/debug/debug_counter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/debug/issp_probe.sv

# The core proper, then the framework glue.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/fuuki_core.sv
set_global_assignment -name SDC_FILE Fuuki.sdc
set_global_assignment -name SYSTEMVERILOG_FILE Fuuki.sv
