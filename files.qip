# ---- FG-3 sound ----
# The OPL4 (YMF278B): full bus protocol, timers with IRQ, and the 24-channel
# PCM wavetable engine, taken from the Psikyo core where it runs on hardware.
# Its FM half is not built there; the OPL3 that fills that gap is separate.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl4/opl4.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl4/opl4_regs.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl4/opl4_pcm.sv

# The OPL4's FM half: gtaylormb/opl3_fpga (LGPL-3.0), a YMF262. The package
# must be compiled before anything that imports it. Its timers are not
# instantiated (opl3_pkg.sv's INSTANTIATE_TIMERS = 0) because opl4_regs owns
# them; timer.sv/timers.sv are listed so the tree stays whole.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/opl3_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/mem_simple_dual_port.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/mem_simple_dual_port_async_read.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/mem_multi_bank.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/mem_multi_bank_reset.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/pipeline_sr.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/edge_detector.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/synchronizer.sv
set_global_assignment -name VERILOG_FILE rtl/sound/opl3/afifo.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/reset_sync.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/clk_div.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/leds.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/timer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/timers.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/host_if.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/trick_sw_detection.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/opl3_log_sine_lut.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/opl3/opl3_exp_lut.sv
